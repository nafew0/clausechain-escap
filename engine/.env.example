# ClauseChain engine settings. Copy to engine/.env and fill in the keys
# (deploy.sh --env-file <file> copies a provided file into place for you).
# One setting per line. Do not put comments after a value on the same line:
# everything after "=" is read as the value.

# ---------------------------------------------------------------------------
# Model A — commercial hosted (the app's "Hybrid" tab, profile hybrid_accuracy)
# ---------------------------------------------------------------------------
CLAUSECHAIN_PROVIDER_PROFILE=hybrid_accuracy
# LLM: OpenAI API directly (default), or OpenRouter:
#   HYBRID_LLM_PROVIDER=openrouter and HYBRID_LLM_MODEL=openai/gpt-6-luna, with OPENROUTER_API_KEY
HYBRID_LLM_PROVIDER=openai
HYBRID_LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Fallback model if the primary fails (optional)
GEMINI_API_KEY=
GEMINI_BULK_MODEL=gemini-3-flash-preview
# Model A embeddings: OpenAI text-embedding-3-small (same OPENAI_API_KEY)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Model B — open weights (the app's "Local" tab, profile local_openweights)
# Any OpenAI-compatible server: vLLM, Ollama /v1, or a hosted open-weights API.
# ---------------------------------------------------------------------------
LOCALAI_ENDPOINT=
LOCALAI_API_KEY=
# The model id the server expects (vLLM --served-model-name)
LOCALAI_MODEL=
# The real open weights, recorded on every finding as model_version
LOCALAI_MODEL_LABEL=
LOCALAI_CONCURRENCY=6
LOCALAI_TIMEOUT_S=300
# Model B embeddings: an OpenAI-compatible bge-m3 server (blank key = reuse LOCALAI_API_KEY)
LOCALAI_EMBED_PROVIDER=openai_compatible
LOCALAI_EMBED_ENDPOINT=
LOCALAI_EMBED_API_KEY=
LOCALAI_EMBED_MODEL=bge-m3

# ---------------------------------------------------------------------------
# OCR for scanned PDFs (only needed when a source has no text layer)
# ---------------------------------------------------------------------------
OCR_PROVIDER=remote_paddle
OCR_ENDPOINT=
PADDLE_OCR_API_KEY=
GOOGLE_VISION_API_KEY=
# Self-hosted Unlimited-OCR (OpenAI-compatible, image input)
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=unlimited-ocr

# ---------------------------------------------------------------------------
# Storage (defaults need no change)
# ---------------------------------------------------------------------------
GRAPH_BACKEND=sqlite
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
