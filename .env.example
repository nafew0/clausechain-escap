# ClauseChain — Docker settings for docker-compose.yml.
# ./deploy.sh (or .\deploy.ps1) writes .env from this file with fresh random
# secrets; you only need to edit it by hand if you skip the script.
#
# Model and OCR keys do NOT go here: the engine reads engine/.env (copy
# engine/.env.example, or pass the provided file to deploy.sh --env-file).

# Where the app is served on this machine.
CLAUSECHAIN_PORT=8080
APP_ORIGIN=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Secrets — any long random strings (deploy.sh generates them).
DJANGO_SECRET_KEY=__CHANGE_ME__
JWT_SIGNING_KEY=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__

# Database name and user (defaults are fine).
POSTGRES_DB=clausechain
POSTGRES_USER=clausechain

# Only set True behind a TLS (https) proxy.
COOKIES_SECURE=False
SECURE_SSL_REDIRECT=False
